/* ─── Chapter Hero Banner (top of every chapter) ─── */
.chapter-page-wrapper .chapter-hero-banner {
  position: relative;
  background: rgba(255, 248, 245, 0.16) !important;
  backdrop-filter: blur(20px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(160%) !important;
  border: 1px solid rgba(212, 160, 110, 0.38) !important;
  border-radius: 9999px !important;
  padding: 16px 42px 14px !important;
  margin: 22px auto 14px !important;
  width: fit-content !important;
  max-width: 95% !important;
  box-shadow:
    0 0 0 1px rgba(255, 200, 170, 0.1),
    0 8px 30px rgba(180, 80, 60, 0.12),
    inset 0 1px 0 rgba(255, 240, 220, 0.22) !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  text-align: center !important;
  box-sizing: border-box !important;
}

/* Rose gold shimmer line at top */
.chapter-page-wrapper .chapter-hero-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(212, 160, 110, 0.7), rgba(255, 200, 150, 0.9), rgba(212, 160, 110, 0.7), transparent);
  border-radius: 999px;
  display: block !important;
}

